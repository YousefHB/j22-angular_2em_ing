# ===== Configuration Render - Variables d'Environnement =====
# Copiez ces variables dans le dashboard Render (Environment Variables)

# Profile Spring Boot
SPRING_PROFILES_ACTIVE=prod

# Port (Render utilise automatiquement $PORT)
PORT=8084

# Base de données
# Pour PostgreSQL (Render): jdbc:postgresql://dpg-xxxxx:5432/shopflow_db
# Pour MySQL externe: jdbc:mysql://host:3306/shopflow_db
DATABASE_URL=jdbc:postgresql://your-db-host:5432/shopflow_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Secret (minimum 32 caractères)
# Générez avec: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Frontend URL (votre app Firebase)
FRONTEND_URL=https://shopflow-25917.web.app

# ===== Configuration Locale (Development) =====
# Pour tester localement avec le profil prod:
# export SPRING_PROFILES_ACTIVE=prod
# export DATABASE_URL=jdbc:mysql://localhost:3306/shopflow_db
# export DB_USERNAME=root
# export DB_PASSWORD=
# export JWT_SECRET=your-local-jwt-secret-key-min-32-chars
# export FRONTEND_URL=http://localhost:4200
